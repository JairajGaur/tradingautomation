# Build output & Gradle caches (rebuilt inside the image)
build/
.gradle/

# Machine-specific Gradle toolchain config — points at Homebrew JDK paths that
# don't exist in the image. Excluding it lets Gradle use the image's bundled JDK.
gradle.properties

# Secrets & local env — passed in at runtime via --env-file / compose, never baked in
.env
*.local

# Version control & IDE
.git/
.gitignore
.idea/
.vscode/
*.iml

# Logs, reports, runtime artifacts
logs/
reports/
*.log
.run/

# Docs & API client collections not needed to build
bruno/
*.md

# OS cruft
.DS_Store

# Don't copy the Docker files into the context
Dockerfile
.dockerignore
docker-compose.yml
