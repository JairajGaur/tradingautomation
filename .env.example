# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the trading-automation app.
#
# USAGE:
#   1. Copy this file to `.env`   ->   cp .env.example .env
#   2. Fill in your real values in `.env` (NEVER commit .env — it's gitignored).
#   3. Start:  ./scripts/start.sh      Stop:  ./scripts/stop.sh
#
# Only WEBULL_APP_KEY and WEBULL_APP_SECRET are REQUIRED (the app fails fast
# without them). Everything else is optional — leave blank to disable that feature.
# ─────────────────────────────────────────────────────────────────────────────

# ── Broker: Webull (REQUIRED) ────────────────────────────────────────────────
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Optional: only needed if 2FA is enabled on the account.
WEBULL_ACCESS_TOKEN=
# Optional: pin a specific account id; blank = auto-pick the margin equity account.
WEBULL_ACCOUNT_ID=

# ── Telegram (all optional) ──────────────────────────────────────────────────
# Shared bot token used by every channel. Blank = no Telegram delivery.
TELEGRAM_BOT_TOKEN=
# Main notifications chat (used by the /api/notifications/test endpoint).
TELEGRAM_CHAT_ID=
# Per-alert channels (there is NO common channel). Blank = that alert is skipped.
TELEGRAM_STADX_CHAT_ID=
TELEGRAM_ORB_CHAT_ID=
TELEGRAM_ORB_UP_CHAT_ID=
TELEGRAM_ORB_DOWN_CHAT_ID=
TELEGRAM_SWIFT_CHAT_ID=
# Options Supertrend alert (app.alerts.option-vol-st) channel.
TELEGRAM_OPTION_VOLST_CHAT_ID=
