[Unit]
Description=Trading Automation server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=trading
WorkingDirectory=/opt/tradingautomation
EnvironmentFile=/opt/tradingautomation/.env
ExecStart=/usr/bin/java -jar /opt/tradingautomation/.run/server.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
