meta {
  name: Get History
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/history/amzn?count=300&order=asc
  body: none
  auth: none
}

params:query {
  count: 300
  order: asc
}

headers {
  Accept: application/json
}

docs {
  # Get Historical Bars
  
  Returns all fetched 1-minute historical bars (OHLCV) for a stock.
  
  Backed by the Webull v3 Data API endpoint POST /market-data/stocks/bars/list.
  
  ## Path parameter
  - `{ticker}` — equity symbol, case-insensitive (e.g. AAPL). Does NOT need to be
    in the watchlist — any US stock symbol works.
  
  ## Query
  - `count` — number of bars (default = webull.trading.warmup-bars; M1 max 1650)
  
  ## Responses
  - `200` — { ticker, count, bars: [ {timestamp, open, high, low, close, volume} ] }
  - `502` — Webull error; includes `webullError` with the failure message
}
