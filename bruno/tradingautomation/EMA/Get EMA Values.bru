meta {
  name: Get EMA Values
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/ema/Aapl?timespan=M1
  body: none
  auth: none
}

params:query {
  timespan: M1
}

headers {
  Accept: application/json
}

docs {
  # Get EMA Values
  
  Returns the configured EMA values for a ticker (default periods: 20, 100,
  200, 600 — set via `webull.trading.ema-periods`).
  
  The ticker in the path must be present in the watchlist (`tickers.txt`).
  
  ## Path parameter
  - `{ticker}` — equity symbol, case-insensitive (e.g. `AAPL`). Change the
    symbol in the URL to query a different watchlist ticker.
  
  ## Responses
  - `200` — EMA values computed from fresh 1-minute bars. A period needing
    more bars than available is reported as `"INSUFFICIENT_DATA"`.
  - `404` — ticker not in the watchlist (response includes the current watchlist).
  - `503` — market-data API returned no bars (common in paper/sandbox off-hours).
}
